# flutter-side local settings — copy to app/.env.local (gitignored).
# scripts/run_web.sh sources this file and forwards the values below as
# --dart-define flags. backend secrets stay in the repo-root .env.local,
# never here.

GOOGLE_MAPS_API_KEY=

# none | firebase (issue #84). local default: none — no events leave the
# device. set firebase only for local firebase smoke testing/DebugView.
ANALYTICS_PROVIDER=none

# fake | fcm (issue #84). local default: fake — the notification opt-in
# stays local ui state and no firebase messaging code runs. set fcm only
# for local push smoke testing against a configured firebase project.
NOTIFICATION_PROVIDER=fake

# web push only, needed with NOTIFICATION_PROVIDER=fcm on the web target:
# the web push certificate (vapid) key pair from the firebase console.
FCM_VAPID_KEY=
