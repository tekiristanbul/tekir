# backend environment template — names and placeholders only, never real
# values. copy to a repo-root .env.local for local secrets; .env.local is
# gitignored and must never be committed. the flutter maps key stays in
# app/.env.local, separate from backend secrets.
#
# the values below are only needed for local real-provider smoke testing
# (DEVELOPMENT.md "otp providers", "firebase", "object storage providers").
# the default local flow (fake providers) needs none of them.

# development | production. development unlocks the fake provider defaults
# (otp, notifications, object storage); production requires explicit real
# providers and rejects fake, unset, and unknown providers at startup.
APP_ENV=development

# fake | twilio. unset defaults to fake only under APP_ENV=development.
OTP_PROVIDER=fake

# required when OTP_PROVIDER=twilio. twilio verify addresses a verify
# service sid — TWILIO_NUMBER is not used by this integration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# optional, only meaningful with OTP_PROVIDER=twilio: an app-review otp
# bypass (issue #184). must both be set or both left unset — comma-separated
# e.164 numbers get the fixed code instead of a real twilio verify sms;
# every other number is unaffected.
OTP_REVIEW_TEST_NUMBERS=
OTP_REVIEW_TEST_CODE=

# fake | fcm. unset defaults to fake only under APP_ENV=development;
# production requires an explicit NOTIFICATION_PROVIDER=fcm and rejects
# fake, unset, and unknown providers at cmd/notifier startup.
NOTIFICATION_PROVIDER=fake

# required when NOTIFICATION_PROVIDER=fcm: absolute path to the firebase
# service-account json (a deployment secret — the file itself must never
# be committed). the firebase project id is read from the file.
FCM_CREDENTIALS_FILE=

# fake | s3. unset defaults to fake only under APP_ENV=development;
# production requires an explicit OBJECT_STORAGE_PROVIDER=s3 and rejects
# fake, unset, unknown, and incompletely configured providers at startup.
# selecting s3 never falls back to local disk.
OBJECT_STORAGE_PROVIDER=fake

# required when OBJECT_STORAGE_PROVIDER=s3. application-owned names on
# purpose — never generic AWS_* names that could pick up unrelated host
# credentials. for digitalocean spaces: the regional endpoint without the
# bucket name (e.g. https://fra1.digitaloceanspaces.com), the region slug,
# the space name, a spaces access key pair, and the public read base url
# (the bucket endpoint, or the cdn endpoint if enabled). the key pair is a
# deployment secret.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# optional: path-style addressing (endpoint-host/bucket) for the rare
# s3-compatible endpoint that needs it. digitalocean spaces does not.
S3_FORCE_PATH_STYLE=false

# fake | cloudflare (issue #241, pre-publication content moderation). unset
# defaults to fake only under APP_ENV=development; production requires an
# explicit MODERATION_PROVIDER=cloudflare and rejects fake, unset, and
# unknown providers at startup. selecting cloudflare never falls back to the
# fake provider.
MODERATION_PROVIDER=fake

# required when MODERATION_PROVIDER=cloudflare: the cloudflare workers ai
# model slugs this deployment moderates text and images/video-contact-sheets
# with. configuration, never a public api/domain concept — see
# docs/architecture/backend.md.
MODERATION_TEXT_MODEL=@cf/google/gemma-4-26b-a4b-it
MODERATION_VISION_MODEL=@cf/moondream/moondream3.1-9B-A2B

# required when MODERATION_PROVIDER=cloudflare. CLOUDFLARE_API_TOKEN is a
# deployment secret — never logged or echoed in errors.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
